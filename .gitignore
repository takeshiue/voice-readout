# Plugin runtime state and secrets normally live OUTSIDE the repo, under
# $CLAUDE_PLUGIN_DATA. These patterns are a defensive net in case that path
# ever resolves into the repo (e.g. its /tmp fallback) so keys/logs never get
# committed.
voice-readout-config
voice-readout-persona.md
voice-readout.env
voice-readout-*-key
voice-readout.log
voice-readout-last-notify
voice-readout-ondevice.lock
.voice-readout-tmp/
*.log


# Article/SNS artwork generated for write-ups about this plugin. Not part of
# what gets installed, so it stays out of the repo.
generated-images/

# Scratch text handed to the readout while tuning by ear. Written once per
# measurement run, never read again, and of no use to anyone else.
.tmp/
.tmp-*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/

# Loudness envelopes from tests/measure-seams.sh (never the audio itself)
.seam-measurements/
