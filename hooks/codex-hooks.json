{
  "description": "Codex-specific lifecycle hooks; Claude Code continues to use hooks.json.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/bin/codex-session-start.sh" }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/bin/codex-session-end.sh", "timeout": 3 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/bin/codex-summarize-and-speak.sh" }]
    }]
  }
}
