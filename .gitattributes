# Keep shell scripts LF on every platform. Git for Windows otherwise checks
# them out as CRLF, and bash/Git Bash then fails on the stray \r (scripts abort
# with "command not found" / bad interpreter). This is the key enabler for the
# Windows checkout of this plugin.
* text=auto eol=lf
*.sh text eol=lf

# PowerShell scripts hold Japanese UI strings and MUST keep their UTF-8 BOM:
# Windows PowerShell 5.1 reads a BOM-less script as the system ANSI code page
# (CP932 on a Japanese install) and renders the Japanese as mojibake. Marked
# -text so git never normalises or strips those leading bytes.
*.ps1 -text

# Pre-rendered audio clips are binary; never touch their bytes.
*.wav binary
